# ========== Makers AI 网关（本地调试用） ==========
# AI_GATEWAY_API_KEY / AI_GATEWAY_BASE_URL 部署到 Makers 时由平台自动注入；
# 本地运行必须手动填写，否则对话会直接报鉴权错误。
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# 模型 ID，默认 @makers/deepseek-v4-flash（内置免费模型，有配额限制）
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ========== 高德地图 Web 服务 Key ==========
# 获取地址：https://console.amap.com/dev/index → 应用管理 → 新建应用 → 添加 Key（服务平台选「Web服务」）
# 出行决策 Agent 的定位、商场检索、品牌核对、距离测量全靠这个 Key
AMAP_API_KEY=

# ========== 离线演示模式（拿到真实 Key 前用） ==========
# 设为 1 时四个工具改读 agents/_fixtures.py 的内置样例数据，不需要高德 Key、不联网。
# 样例取景地是「北京西城区红莲南路地铁站」，正好覆盖手册 6.1 / 6.2 两个场景。
# 部署上线前务必删掉这一行或改成 0，否则线上会用假数据。
# AMAP_MOCK=1
